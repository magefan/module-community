    .mf-ra-bubble{position:absolute;left:138px;bottom:118px;width:max-content;max-width:230px;background:#fff;color:#101828;border:1px solid #C9DFF5;border-radius:14px;padding:9px 13px;font-size:13.5px;font-weight:600;line-height:1.3;box-shadow:0 8px 22px rgba(16,24,40,.14);pointer-events:auto;transform-origin:0 100%;transform:scale(.5);opacity:0;visibility:hidden;transition:transform .15s ease-in,opacity .15s ease-in,visibility 0s .15s;}
    .mf-ra-bubble::after{content:"";position:absolute;left:12px;bottom:-7px;width:12px;height:12px;background:#fff;border-right:1px solid #C9DFF5;border-bottom:1px solid #C9DFF5;transform:rotate(45deg) skew(8deg,8deg);}
    .mf-ra.is-in:hover .mf-ra-bubble,.mf-ra.is-in:focus-within .mf-ra-bubble,.mf-ra.is-hello .mf-ra-bubble{transform:scale(1);opacity:1;visibility:visible;transition:transform .35s cubic-bezier(.34,1.56,.64,1) .3s,opacity .2s ease-out .3s,visibility 0s .3s;}
