    .mf-ra-bubble .mf-ra-rate{color:#1570CD;font-weight:700;margin-top:2px;}
    .mf-ra-bubble .mf-ra-later{color:#6B7280;font-size:12px;font-weight:600;margin-top:6px;}
    .mf-ra-bubble button:hover{text-decoration:underline;}
    .mf-ra-bubble button:focus-visible{outline:2px solid #2E6BD9;outline-offset:2px;border-radius:4px;}
    @keyframes mf-ra-blink{0%,91%,100%{transform:scaleY(0);}94%{transform:scaleY(1);}97%{transform:scaleY(0);}}
    @keyframes mf-ra-wave{0%{transform:rotate(0);}12%{transform:rotate(-10deg);}26%{transform:rotate(2deg);}40%{transform:rotate(-10deg);}54%{transform:rotate(2deg);}66%{transform:rotate(-7deg);}80%,100%{transform:rotate(0);}}
