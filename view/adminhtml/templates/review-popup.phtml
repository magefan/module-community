        .mf-ra-move,.mf-ra.is-in:hover .mf-ra-move{transition-duration:.01s;}
        .mf-ra .mf-ra-lid,.mf-ra .mf-ra-tab,.mf-ra .mf-ra-star{animation:none!important;}
    }
</style>
