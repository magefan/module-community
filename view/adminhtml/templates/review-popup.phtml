    .mf-ra.is-in:hover .mf-ra-tab,.mf-ra.is-in:focus-within .mf-ra-tab,.mf-ra.is-hello .mf-ra-tab{animation:mf-ra-wave 1.9s ease-in-out .45s infinite;}
