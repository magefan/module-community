<?php
$remindLaterUrl = $escaper->escapeJs($escaper->escapeUrl(
    $block->getUrl('mfcommunity/remindlater/index', ['_nosecret' => false])
));
$moduleNameJs   = $escaper->escapeJs($block->getModuleName());
echo /* @NoEscape */ $block->getLayout()->createBlock(\Magefan\Community\Block\JsScript::class)->setMethod('sendBeacon')->toHtml();
$script = <<<JS
function mfRemindLater(el, event) {
    var messageBlock = el.closest('.message');
    if (messageBlock) {
        messageBlock.style.transition = 'opacity 0.5s';
        messageBlock.style.opacity = '0';
        setTimeout(function() { messageBlock.style.display = 'none'; }, 500);
        MagefanJs.sendBeacon({
            url: '{$remindLaterUrl}',
            data: { event: event, module: '{$moduleNameJs}' }
        });
    }
}
JS;
echo $mfSecureRenderer->renderTag('script', [], $script, false);
?>
